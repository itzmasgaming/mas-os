[Unit]
Description=MAS graphics mode (safe drawing inside virtual machines)
Before=display-manager.service sddm.service
After=local-fs.target systemd-sysusers.service mas-gfx-ask.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/mas-gfx apply

[Install]
WantedBy=multi-user.target
