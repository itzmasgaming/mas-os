# MAS boot screen - Windows style: black screen, the MAS logo in the middle, and a ring of
# white dots that chase each other around underneath while the computer starts.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();
screen.cx = Window.GetX() + screen.w / 2;
screen.cy = Window.GetY() + screen.h / 2;

# ---- logo: about 24% of the screen height, a little above the middle ----
logo.raw = Image("logo.png");
logo.scale = (screen.h * 0.24) / logo.raw.GetHeight();
logo.image = logo.raw.Scale(logo.raw.GetWidth() * logo.scale, logo.raw.GetHeight() * logo.scale);
logo.sprite = Sprite(logo.image);
logo.x = screen.cx - logo.image.GetWidth() / 2;
logo.y = screen.cy - logo.image.GetHeight() / 2 - screen.h * 0.06;
logo.sprite.SetPosition(logo.x, logo.y, 10);
logo.sprite.SetOpacity(0);

# ---- spinner: 6 dots on a small circle under the logo ----
spin.count = 6;
spin.radius = screen.h * 0.022;
spin.cx = screen.cx;
spin.cy = logo.y + logo.image.GetHeight() + screen.h * 0.085;
spin.dot_raw = Image("dot.png");
spin.dot_size = screen.h * 0.0085;
if (spin.dot_size < 5) spin.dot_size = 5;
spin.dot_img = spin.dot_raw.Scale(spin.dot_size, spin.dot_size);
for (i = 0; i < spin.count; i++)
  {
    spin.dot[i] = Sprite(spin.dot_img);
    spin.dot[i].SetOpacity(0);
    spin.dot[i].SetPosition(spin.cx, spin.cy, 10);
  }

frame = 0;

fun refresh_callback ()
  {
    frame++;
    t = frame / 50;    # roughly seconds (50 fps)

    fade = frame / 30;
    if (fade > 1) fade = 1;
    logo.sprite.SetOpacity(fade);

    for (i = 0; i < spin.count; i++)
      {
        # every dot runs the same loop, a little later than the one before it; each loop starts
        # slow, speeds up, and slows down again, like the Windows dots
        p = t / 2.4 - i * 0.055;
        p = p - Math.Int(p);
        if (p < 0) p = p + 1;
        ease = p * p * (3 - 2 * p);
        a = -Math.Pi / 2 + ease * 2 * Math.Pi;
        x = spin.cx + spin.radius * Math.Cos(a) - spin.dot_size / 2;
        y = spin.cy + spin.radius * Math.Sin(a) - spin.dot_size / 2;
        spin.dot[i].SetPosition(x, y, 10);
        # a short pause between loops: dots hide at the very start and end of the loop
        o = 1;
        if (p < 0.03) o = p / 0.03;
        if (p > 0.97) o = (1 - p) / 0.03;
        spin.dot[i].SetOpacity(fade * o);
      }
  }
Plymouth.SetRefreshFunction (refresh_callback);

# A line of text under the dots (used for "Forgot your password? Press R")
message_sprite = Sprite();
fun display_message_callback (text)
  {
    img = Image.Text(text, 0.8, 0.8, 0.8);
    message_sprite.SetImage(img);
    message_sprite.SetOpacity(1);
    message_sprite.SetPosition(screen.cx - img.GetWidth() / 2,
                               spin.cy + screen.h * 0.07, 20);
  }
fun hide_message_callback (text)
  {
    message_sprite.SetOpacity(0);
  }
Plymouth.SetDisplayMessageFunction (display_message_callback);
Plymouth.SetHideMessageFunction (hide_message_callback);
