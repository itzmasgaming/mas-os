#!/usr/bin/python3
"""mas-update-notify - runs in the background after login and shows a small card when a MAS update is ready or installed."""
import json, os, subprocess, sys, threading
import gi
gi.require_version('Gtk', '3.0'); gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, GLib
import cairo

STATUS = os.environ.get('MAS_STATUS', '/var/lib/mas/update/status.json')
FLAG = os.environ.get('MAS_REBOOT_FLAG', '/run/mas-reboot-needed')
SEEN = os.path.expanduser('~/.config/mas/update-notified')
INTERVAL = int(os.environ.get('MAS_NOTIFY_INTERVAL', '60'))
UPDATE = '/usr/local/bin/mas-update'


def status():
    try:
        st = json.load(open(STATUS))
    except Exception:
        return {}
    st['reboot_needed'] = os.path.exists(FLAG)
    return st


def seen():
    try: return open(SEEN).read().strip()
    except Exception: return ''


def remember(key):
    try:
        os.makedirs(os.path.dirname(SEEN), exist_ok=True); open(SEEN, 'w').write(key)
    except Exception: pass


class Toast(Gtk.Window):
    def __init__(self, title, text, buttons):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_decorated(False); self.set_skip_taskbar_hint(True); self.set_keep_above(True); self.set_resizable(False)
        self.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION); self.set_accept_focus(False)
        screen = self.get_screen()
        self.comp = bool(screen.is_composited() and screen.get_rgba_visual())
        if self.comp: self.set_visual(screen.get_rgba_visual())
        self.set_app_paintable(True)
        css = Gtk.CssProvider(); css.load_from_data(b"window.mas-toast-root { background-color: transparent; }")
        Gtk.StyleContext.add_provider_for_screen(screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.get_style_context().add_class('mas-toast-root')
        outer = Gtk.Box(); outer.get_style_context().add_class('mas-toast'); outer.set_size_request(360, -1)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=16); outer.pack_start(v, True, True, 0)
        h = Gtk.Box(spacing=12); h.pack_start(Gtk.Image.new_from_icon_name('mas-update', Gtk.IconSize.DND), False, False, 0)
        t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        l1 = Gtk.Label(xalign=0); l1.set_markup('<b>%s</b>' % GLib.markup_escape_text(title))
        l2 = Gtk.Label(label=text, xalign=0); l2.set_line_wrap(True); l2.get_style_context().add_class('mas-sub')
        t.pack_start(l1, False, False, 0); t.pack_start(l2, False, False, 0); h.pack_start(t, True, True, 0)
        v.pack_start(h, False, False, 0)
        bar = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        for label, cb, suggested in buttons:
            b = Gtk.Button(label=label)
            if suggested: b.get_style_context().add_class('suggested-action')
            b.connect('clicked', lambda _b, f=cb: (f(), self.destroy()))
            bar.pack_start(b, False, False, 0)
        v.pack_start(bar, False, False, 0)
        self.add(outer); self.connect('size-allocate', self.on_size)
        self.show_all(); self.place()

    def place(self):
        d = Gdk.Display.get_default(); m = d.get_primary_monitor() or d.get_monitor(0); wa = m.get_workarea()
        _, nat = self.get_preferred_size()
        self.move(wa.x + wa.width - nat.width - 14, wa.y + wa.height - nat.height - 14)

    def on_size(self, *_):
        if self.comp: return
        a = self.get_allocation(); w, h = a.width, a.height; r = 14
        if w < 10: return
        s = cairo.ImageSurface(cairo.FORMAT_A8, w, h); cr = cairo.Context(s); cr.new_sub_path()
        for cx, cy, st in ((w - r, r, -90), (w - r, h - r, 0), (r, h - r, 90), (r, r, 180)):
            cr.arc(cx, cy, r, st * 3.14159265 / 180, (st + 90) * 3.14159265 / 180)
        cr.close_path(); cr.fill(); self.shape_combine_region(Gdk.cairo_region_create_from_surface(s))


class App:
    def __init__(self):
        self.toast = None

    def check(self):
        if self.toast is not None and self.toast.get_visible(): return True
        st = status(); state = st.get('state', ''); latest = st.get('latest', '')
        if st.get('reboot_needed'):
            key = f'installed:{latest}'; title = f'MAS updated to {latest}'; text = 'Restart to finish the update.'
            btns = [('Later', lambda: None, False), ('Restart now', lambda: subprocess.Popen(['systemctl', 'reboot']), True)]
        elif state == 'available':
            key = f'available:{latest}'; title = f'MAS {latest} is ready'; text = (st.get('notes') or 'A new version of MAS is ready to install.')[:140]
            btns = [('Later', lambda: None, False), ('Install now', lambda: threading.Thread(target=lambda: subprocess.run(['sudo', '-n', UPDATE, 'install']), daemon=True).start(), True)]
        else:
            return True
        if seen() == key: return True
        remember(key)
        self.toast = Toast(title, text, btns)
        return True


def main():
    a = App()
    GLib.timeout_add_seconds(5, lambda: (a.check(), False)[1])
    GLib.timeout_add_seconds(INTERVAL, a.check)
    Gtk.main()


if __name__ == '__main__':
    main()
