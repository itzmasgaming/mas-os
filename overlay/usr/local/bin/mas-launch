#!/bin/bash
# mas-launch PROGRAM [ARGS...] - starts a program with the busy pointer, and ignores a second click on the same thing within 3 seconds.
[[ $# -gt 0 ]] || exit 0
dir="${XDG_RUNTIME_DIR:-/tmp}"; key="$dir/mas-launch-$(printf '%s' "$*" | md5sum | cut -c1-16)"
now=$(date +%s)
if [[ -f $key ]]; then last=$(stat -c %Y "$key" 2>/dev/null || echo 0); (( now - last < 3 )) && exit 0; fi
touch "$key"
command -v mas-busy >/dev/null 2>&1 && { mas-busy >/dev/null 2>&1 & disown; }
exec "$@"
