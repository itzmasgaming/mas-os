def xq(ch, prop, *args):
    return sh('xfconf-query', '-c', ch, '-p', prop, *args, timeout=8)


def start(cmd):
    import shutil
    if shutil.which(cmd[0]) is None: return False
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return True



def _rd(p, d=''):
    try:
        with open(p) as f: return f.read().strip()
    except Exception: return d


def _gb(b):
    return ('%.1f GB' % (b / 1e9)) if b >= 1e9 else ('%.0f MB' % (b / 1e6))


def sysinfo():
    """Everything about this computer, read from /proc, /sys and a few tools."""
    import platform, shutil
    rel = {}
    for l in _rd('/etc/os-release').splitlines():
        if '=' in l: k, v = l.split('=', 1); rel[k] = v.strip('"')
    mas = {}
    for l in _rd('/etc/mas-release').splitlines():
        if '=' in l: k, v = l.split('=', 1); mas[k] = v.strip().strip('"')
    cpu = {}
    models = []
    for l in _rd('/proc/cpuinfo').splitlines():
        if ':' in l:
            k, v = [x.strip() for x in l.split(':', 1)]
            if k == 'model name': models.append(v)
            cpu.setdefault(k, v)
    cpu_name = (models[0] if models else platform.processor() or 'Unknown')
    threads = os.cpu_count() or 1
    cores = threads
    rc, out = sh('lscpu')
    ls = {}
    for l in out.splitlines():
        if ':' in l: k, v = l.split(':', 1); ls[k.strip()] = v.strip()
    try: cores = int(ls.get('Core(s) per socket', 0)) * int(ls.get('Socket(s)', 1)) or threads
    except Exception: pass
    mhz = ''
    try:
        mx = float(ls.get('CPU max MHz') or cpu.get('cpu MHz') or 0)
        if mx: mhz = '%.2f GHz' % (mx / 1000)
    except Exception: pass
    mem = {}
    for l in _rd('/proc/meminfo').splitlines():
        k, v = l.split(':', 1); mem[k] = int(v.split()[0]) * 1024
    total, avail = mem.get('MemTotal', 0), mem.get('MemAvailable', 0)
    swap = mem.get('SwapTotal', 0)
    # RAM details (type, speed, slots) need root; try the plain route first
    ram_extra = ''
    rc, out = sh('sudo', '-n', 'dmidecode', '-t', 'memory', timeout=6)
    if rc == 0:
        sticks = []; cur = {}
        for l in out.splitlines() + ['']:
            l = l.strip()
            if not l:
                if cur.get('Size', 'No Module Installed').lower().startswith(('no module', 'unknown')) is False and cur.get('Size'):
                    sticks.append('%s %s %s' % (cur.get('Size'), cur.get('Type', ''), cur.get('Speed', '')))
                cur = {}
            elif ':' in l: k, v = l.split(':', 1); cur[k.strip()] = v.strip()
        if sticks: ram_extra = ', '.join(sticks)
    gpus = []
    rc, out = sh('lspci')
    for l in out.splitlines():
        if any(x in l for x in ('VGA', '3D controller', 'Display controller')):
            gpus.append(l.split(': ', 1)[-1].strip())
    # screens
    screens = []
    try:
        d = Gdk.Display.get_default()
        for i in range(d.get_n_monitors()):
            m = d.get_monitor(i); g = m.get_geometry()
            screens.append('%dx%d @%s%s' % (g.width * m.get_scale_factor(), g.height * m.get_scale_factor(),
                           ('%.0f Hz' % (m.get_refresh_rate() / 1000)) if m.get_refresh_rate() else '?', ' (primary)' if m.is_primary() else ''))
    except Exception: pass
    # disks
    disks = []
    rc, out = sh('lsblk', '-dbno', 'NAME,SIZE,MODEL,TYPE,ROTA')
    for l in out.splitlines():
        p = l.split(None, 4)
        if len(p) >= 4 and p[-2:-1] != ['loop'] and 'disk' in l.split():
            try:
                f = l.split(); name, size = f[0], int(f[1]); kind = 'SSD' if f[-1] == '0' else 'HDD'
                model = ' '.join(f[2:-2]) or 'Disk'
                if name.startswith(('zram', 'sr', 'loop', 'ram')) or size < 200e6: continue
                disks.append('%s  %s  (%s, %s)' % (model, _gb(size), kind, name))
            except Exception: pass
    du = shutil.disk_usage('/')
    dmi = '/sys/class/dmi/id/'
    vendor, prod = _rd(dmi + 'sys_vendor'), _rd(dmi + 'product_name')
    model = ('%s %s' % (vendor, prod)).strip() or 'Computer'
    if prod in ('', 'System Product Name', 'To Be Filled By O.E.M.') and _rd(dmi + 'board_name'): model = '%s %s' % (_rd(dmi + 'board_vendor'), _rd(dmi + 'board_name'))
    bat = ''
    for p in ('BAT0', 'BAT1'):
        b = '/sys/class/power_supply/' + p
        if os.path.exists(b): bat = '%s%%  (%s)' % (_rd(b + '/capacity', '?'), _rd(b + '/status', '?')); break
    up = float(_rd('/proc/uptime', '0 0').split()[0]); dd, rem = divmod(int(up), 86400); hh, rem = divmod(rem, 3600)
    nm = []
    rc, out = sh('nmcli', '-t', '-f', 'DEVICE,TYPE,STATE,CONNECTION', 'device')
    for l in out.splitlines():
        p = l.split(':')
        if len(p) >= 3 and p[1] in ('wifi', 'ethernet') and p[2] == 'connected': nm.append('%s (%s)' % (p[3] if len(p) > 3 and p[3] else p[0], p[1]))
    wine = sh('wine', '--version')[1].strip()
    efi = 'UEFI' if os.path.exists('/sys/firmware/efi') else 'Legacy BIOS'
    sections = [
      ('DEVICE', [
        ('Device name', platform.node()), ('Model', model),
        ('Processor', '%s' % cpu_name), ('CPU cores / threads', '%d cores / %d threads%s' % (cores, threads, ('  ·  up to ' + mhz) if mhz else '')),
        ('Installed RAM', '%s  (%s available now)' % (_gb(total), _gb(avail))),
        ('RAM modules', ram_extra or 'Run "sudo dmidecode -t memory" for the exact modules'),
        ('Swap', _gb(swap) if swap else 'None'),
        ('Graphics', ('\n'.join(gpus)) or 'Unknown'),
        ('Display', ('\n'.join(screens)) or 'Unknown'),
        ('Storage', ('\n'.join(disks)) or 'Unknown'),
        ('System drive', '%s used of %s  (%s free)' % (_gb(du.used), _gb(du.total), _gb(du.free))),
        ('Battery', bat or 'None (desktop)'),
        ('Network', ', '.join(nm) or 'Not connected'),
        ('Up time', '%d days %d hours' % (dd, hh) if dd else '%d hours %d minutes' % (hh, rem // 60)),
      ]),
      ('FIRMWARE', [
        ('BIOS / UEFI', '%s %s  (%s)' % (_rd(dmi + 'bios_vendor'), _rd(dmi + 'bios_version'), _rd(dmi + 'bios_date'))),
        ('Boot mode', efi),
        ('Motherboard', ('%s %s' % (_rd(dmi + 'board_vendor'), _rd(dmi + 'board_name'))).strip() or 'Unknown'),
        ('Chassis', {'3': 'Desktop', '9': 'Laptop', '10': 'Notebook', '8': 'Portable', '14': 'Sub-notebook', '31': 'Convertible', '32': 'Detachable'}.get(_rd(dmi + 'chassis_type'), _rd(dmi + 'chassis_type') or 'Unknown')),
      ]),
      ('MAS', [
        ('Edition', 'MAS OS'), ('Version', mas.get('VERSION', '?')),
        ('Base', rel.get('PRETTY_NAME', 'Arch Linux')), ('Kernel', platform.release()), ('Architecture', platform.machine()),
        ('Desktop', os.environ.get('XDG_CURRENT_DESKTOP', 'XFCE') + ' (' + ('Wayland' if os.environ.get('WAYLAND_DISPLAY') else 'X11') + ')'),
        ('Windows programs', wine or 'Wine not installed'),
      ]),
    ]
    return {'_host': platform.node() or 'MAS', '_model': model, '_sections': sections}


class Settings(Gtk.Window):
    def __init__(self, page):
        super().__init__(title='Settings')
        self.set_default_size(1000, 680); self.set_icon_name('mas-settings')
        self.busy = False; self.history = []
        prov = Gtk.CssProvider(); prov.load_from_data(EXTRA_CSS)
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); self.add(root)
        # header bar of the page (back button + title), hidden on the home screen
        self.bar = Gtk.Box(spacing=10, margin=10)
        self.back = Gtk.Button.new_from_icon_name('go-previous-symbolic', Gtk.IconSize.BUTTON); self.back.connect('clicked', lambda _b: self.go_back())
        self.bar_title = label('', 'mas-big')
        self.bar.pack_start(self.back, False, False, 0); self.bar.pack_start(self.bar_title, False, False, 6)
        root.pack_start(self.bar, False, False, 0)
        self.stack = Gtk.Stack(); self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        root.pack_start(self.stack, True, True, 0)
        self.stack.add_named(self.page_home(), 'home')
        for key, _t, _s, _i, items in CATS: self.stack.add_named(self.page_category(key, _t, items), 'cat:' + key)
        self.stack.add_named(self.page_search(), 'search')
        for name, fn in (('personalize', self.page_personalize), ('fonts', self.page_fonts), ('update', self.page_update), ('about', self.page_about)):
            self.stack.add_named(self.wrap_scroll(fn()), name)
        self.show_all()
        self.open(page if page != 'home' else 'home')
        GLib.timeout_add_seconds(3, self.tick)

    # ---- navigation
    def wrap_scroll(self, w):
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); sc.add(w); return sc

    def open(self, name, push=True):
        key = 'cat:' + name if name in [c[0] for c in CATS] else name
        cur = self.stack.get_visible_child_name()
        if push and cur and cur != key: self.history.append(cur)
        self.stack.set_visible_child_name(key)
        home = key == 'home'
        self.bar.set_visible(not home)
        title = PAGE_TITLES.get(key) or ({('cat:' + c[0]): c[1] for c in CATS}.get(key)) or ('Search results' if key == 'search' else '')
        self.bar_title.set_text(title); self.set_title('Settings' + ('' if home else ' · ' + title))
        if key == 'update': self.refresh_update()

    def go_back(self):
        self.open(self.history.pop() if self.history else 'home', push=False)

    def tick(self):
        if self.stack.get_visible_child_name() == 'update' and not self.busy: self.refresh_update()
        return True

    # ---- home
    def page_home(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        hero = Gtk.Box(spacing=18); hero.get_style_context().add_class('mas-hero')
        name = GLib.get_real_name()
        if not name or name == 'Unknown': name = GLib.get_user_name()
        face = os.path.expanduser('~/.face')
        if os.path.exists(face):
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_size(face, 80, 80); av = Gtk.Image.new_from_pixbuf(pb)
            except Exception: av = None
        else: av = None
        if av is None:
            av = Gtk.Label(label=(name[:1] or 'M').upper()); av.get_style_context().add_class('mas-avatar')
        who = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER)
        who.pack_start(label(name, 'mas-big'), False, False, 0); who.pack_start(label('Local account', 'mas-sub'), False, False, 0)
        left = Gtk.Box(spacing=16); left.pack_start(av, False, False, 0); left.pack_start(who, False, False, 0)
        logo = Gtk.Image.new_from_icon_name('mas-start', Gtk.IconSize.DIALOG); logo.set_pixel_size(72)
        hero.pack_start(left, True, True, 0); hero.pack_start(logo, True, False, 0)
        short = Gtk.Box(spacing=18, halign=Gtk.Align.END)
        self.home_upd = self.shortcut('mas-update', 'MAS Update', 'Checking...', lambda: self.open('update'))
        short.pack_start(self.home_upd[0], False, False, 0)
        short.pack_start(self.shortcut('mas-restore', 'Restore points', 'Go back in time', lambda: start(['mas-restore']))[0], False, False, 0)
        hero.pack_start(short, True, True, 0)
        box.pack_start(hero, False, False, 0)
        self.search = Gtk.SearchEntry(placeholder_text='Find a setting', halign=Gtk.Align.CENTER, width_request=420, margin_top=18, margin_bottom=10)
        self.search.connect('search-changed', self.on_search); box.pack_start(self.search, False, False, 0)
        grid = Gtk.FlowBox(max_children_per_line=5, min_children_per_line=2, selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           column_spacing=6, row_spacing=6, margin=36, valign=Gtk.Align.START)
        for key, title, sub, icon, items in CATS:
            b = Gtk.Button(relief=Gtk.ReliefStyle.NONE); b.get_style_context().add_class('mas-tile')
            h = Gtk.Box(spacing=14)
            img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DND); img.set_pixel_size(40); img.set_valign(Gtk.Align.START)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            t = label(title); t.set_markup('<b>%s</b>' % GLib.markup_escape_text(title))
            d = label(sub, 'mas-sub', wrap=True); d.set_max_width_chars(26)
            v.pack_start(t, False, False, 0); v.pack_start(d, False, False, 0)
            h.pack_start(img, False, False, 0); h.pack_start(v, True, True, 0); b.add(h)
            b.connect('clicked', lambda _b, k=key: self.open('cat:' + k))
            grid.add(b)
        box.pack_start(grid, False, False, 0)
        sc = Gtk.ScrolledWindow(); sc.add(box); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        GLib.idle_add(self.home_status)
        return sc

    def shortcut(self, icon, title, sub, cb):
        b = Gtk.Button(relief=Gtk.ReliefStyle.NONE); b.get_style_context().add_class('mas-tile')
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, halign=Gtk.Align.START)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR); img.set_halign(Gtk.Align.START)
        s = label(sub, 'mas-sub')
        v.pack_start(img, False, False, 0); v.pack_start(label(title), False, False, 0); v.pack_start(s, False, False, 0)
        b.add(v); b.connect('clicked', lambda _b: cb())
        return b, s

    def home_status(self):
        def work():
            rc, out = sh(UPDATE, 'status') if os.path.exists(UPDATE) else (1, '')
            txt = 'Open to check'
            try:
                st = json.loads(out); txt = 'Update available' if st.get('available') else 'Up to date'
            except Exception: pass
            GLib.idle_add(self.home_upd[1].set_text, txt)
        threading.Thread(target=work, daemon=True).start()
        return False

    # ---- a category page: the rows
    def page_category(self, key, title, items):
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=24)
        for it in items: box.pack_start(self.make_row(it), False, False, 0)
        sc.add(box); return sc

    def page_search(self):
        self.res_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=24)
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); sc.add(self.res_box); return sc

    def on_search(self, entry):
        q = entry.get_text().strip().lower()
        if not q:
            if self.stack.get_visible_child_name() == 'search': self.open('home', push=False)
            return
        for c in self.res_box.get_children(): self.res_box.remove(c)
        n = 0
        for key, ctitle, _s, _i, items in CATS:
            for it in items:
                if q in (it['title'] + ' ' + it['desc'] + ' ' + ctitle).lower():
                    r = self.make_row(it, suffix=ctitle); self.res_box.pack_start(r, False, False, 0); n += 1
        if not n: self.res_box.pack_start(label('No settings match "%s".' % q, 'mas-sub'), False, False, 0)
        self.res_box.show_all()
        if self.stack.get_visible_child_name() != 'search':
            self.history = []; self.open('search')

    def make_row(self, it, suffix=None):
        card = Gtk.Box(spacing=12); card.get_style_context().add_class('mas-card')
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        t = label(it['title']); t.set_markup('<b>%s</b>' % GLib.markup_escape_text(it['title']) + ('  <small>· %s</small>' % GLib.markup_escape_text(suffix) if suffix else ''))
        v.pack_start(t, False, False, 0); v.pack_start(label(it['desc'], 'mas-sub', wrap=True), False, False, 0)
        card.pack_start(v, True, True, 0)
        k = it['kind']
        if k in ('run', 'page', 'action'):
            b = Gtk.Button(label=it.get('button', 'Open')); b.set_valign(Gtk.Align.CENTER)
            b.connect('clicked', lambda _b, i=it: self.do(i, _b)); card.pack_start(b, False, False, 0)
        elif k in ('toggle', 'cmdtoggle'):
            sw = Gtk.Switch(valign=Gtk.Align.CENTER); card.pack_start(sw, False, False, 0)
            self.load_toggle(it, sw)
        elif k in ('choice', 'cmdchoice'):
            cb = Gtk.ComboBoxText(valign=Gtk.Align.CENTER)
            for lab, _v in it['opts']: cb.append_text(lab)
            card.pack_start(cb, False, False, 0); self.load_choice(it, cb)
        return card

    def do(self, it, btn):
        k = it['kind']
        if k == 'page': self.open(it['page'])
        elif k == 'run':
            if it['title'].startswith('Android'): return self.toast(btn, 'Not available yet')
            if not start(it['cmd']): self.toast(btn, 'Not installed on this system')
        elif k == 'action':
            sh(*it['cmd']); self.toast(btn, 'Done')

    def toast(self, btn, text):
        old = btn.get_label(); btn.set_label(text); GLib.timeout_add(1800, lambda: (btn.set_label(old), False)[1])

    def load_toggle(self, it, sw):
        def work():
            if it['kind'] == 'toggle':
                rc, out = xq(it['ch'], it['prop']); out = out.strip()
                if rc != 0: on = it['typ'] == 'int' or it['prop'] in DEFAULT_ON
                elif it['typ'] == 'int': on = out != str(it['off'])
                else: on = out == 'true'
            else:
                rc, out = sh(*it['get']); on = bool(rc == 0 and it['is_on'](out))
            def fin():
                sw.set_active(on); sw.connect('notify::active', lambda s, _p: self.set_toggle(it, s))
                return False
            GLib.idle_add(fin)
        threading.Thread(target=work, daemon=True).start()

    def set_toggle(self, it, sw):
        on = sw.get_active()
        def work():
            if it['kind'] == 'toggle':
                if it['typ'] == 'int': val, typ = str(it['on'] if on else it['off']), 'int'
                else: val, typ = ('true' if on else 'false'), 'bool'
                xq(it['ch'], it['prop'], '-n', '-t', typ, '-s', val)
            else:
                sh(*(it['on'] if on else it['off']), timeout=60)
        threading.Thread(target=work, daemon=True).start()

    def load_choice(self, it, cb):
        def work():
            if it['kind'] == 'choice':
                rc, out = xq(it['ch'], it['prop']); cur = out.strip() if rc == 0 else None
                if cur in (None, '-1'): cur = str(it.get('default', it['opts'][0][1]))
                idx = next((i for i, (_l, v) in enumerate(it['opts']) if str(v) == cur), -1)
            else:
                rc, out = sh(*it['get']); cur = out.strip()
                idx = next((i for i, (_l, v) in enumerate(it['opts']) if v == cur), -1)
            def fin():
                if idx >= 0: cb.set_active(idx)
                cb.connect('changed', lambda c: self.set_choice(it, c)); return False
            GLib.idle_add(fin)
        threading.Thread(target=work, daemon=True).start()

    def set_choice(self, it, cb):
        i = cb.get_active()
        if i < 0: return
        v = it['opts'][i][1]
        def work():
            if it['kind'] == 'choice': xq(it['ch'], it['prop'], '-n', '-t', 'int', '-s', str(v))
            else: sh(*it['setter'](v), timeout=60)
        threading.Thread(target=work, daemon=True).start()

    # ------------------------------------------------------------ Personalize
    def page_personalize(self):
        a = appearance()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=28)
        box.pack_start(label('Mode', 'mas-title'), False, False, 0)
        row = Gtk.Box(spacing=10, homogeneous=True); self.mode_btns = {}
        for m, name, icon in (('dark', 'Dark', 'mas-mode-dark'), ('light', 'Light', 'mas-mode-light')):
            b = Gtk.ToggleButton(); b.get_style_context().add_class('mas-seg')
            h = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER); h.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON), False, False, 0)
            h.pack_start(Gtk.Label(label=name), False, False, 0); b.add(h)
            b.set_active(a.get('mode') == m); b.connect('clicked', self.on_mode, m)
            self.mode_btns[m] = b; row.pack_start(b, True, True, 0)
        box.pack_start(row, False, False, 0)
        box.pack_start(label('Background', 'mas-title'), False, False, 6)
        grid = Gtk.Box(spacing=12); self.back_btns = {}
        for key, name in BACKS:
            thumb = f'{SHARE}/wallpapers/thumb-' + (f'mas-{a.get("mode", "dark")}' if key == 'mas' else key) + '.jpg'
            b = Gtk.ToggleButton(); b.get_style_context().add_class('mas-thumb')
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(thumb, 150, 84, False); img = Gtk.Image.new_from_pixbuf(pb)
            except Exception:
                img = Gtk.Image()
            v.pack_start(img, False, False, 0); v.pack_start(Gtk.Label(label=name), False, False, 0); b.add(v)
            b.set_active(a.get('wallpaper') == key); b.connect('clicked', self.on_back, key)
            self.back_btns[key] = b; grid.pack_start(b, False, False, 0)
        box.pack_start(grid, False, False, 0)
        own = Gtk.Button(label='Choose your own picture'); own.connect('clicked', self.on_own)
        box.pack_start(own, False, False, 4)
        sw = Gtk.Box(spacing=12); sw.pack_start(label('Smooth effects (rounded corners, shadows)'), True, True, 0)
        self.fx = Gtk.Switch(active=bool(a.get('effects', True)), valign=Gtk.Align.CENTER); self.fx.connect('notify::active', self.on_fx)
        sw.pack_start(self.fx, False, False, 0); box.pack_start(sw, False, False, 10)
        box.pack_start(label('Turn effects off if the desktop feels slow (for example in a virtual machine).', 'mas-sub'), False, False, 0)
        return box

    def run_async(self, *cmd, done=None):
        def work():
            sh(*cmd)
            if done: GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()

    def on_mode(self, btn, mode):
        if not btn.get_active():
            if not any(b.get_active() for b in self.mode_btns.values()): btn.set_active(True)
            return
        for m, b in self.mode_btns.items():
            if m != mode: b.set_active(False)
        self.run_async(APPEAR, 'mode', mode)

    def on_back(self, btn, key):
        if not btn.get_active():
            if not any(b.get_active() for b in self.back_btns.values()): btn.set_active(True)
            return
        for k, b in self.back_btns.items():
            if k != key: b.set_active(False)
        self.run_async(APPEAR, 'wallpaper', key)

    def on_own(self, _b):
        dlg = Gtk.FileChooserDialog(title='Choose a picture', parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Use this picture', Gtk.ResponseType.OK)
        f = Gtk.FileFilter(); f.set_name('Pictures'); f.add_mime_type('image/jpeg'); f.add_mime_type('image/png'); f.add_mime_type('image/webp'); dlg.add_filter(f)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            for b in self.back_btns.values(): b.set_active(False)
            self.run_async(APPEAR, 'wallpaper', path)
        dlg.destroy()

    def on_fx(self, sw, _p):
        self.run_async(APPEAR, 'effects', 'on' if sw.get_active() else 'off')

    # ------------------------------------------------------------ Fonts
    def page_fonts(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=28)
        box.pack_start(label('Fonts', 'mas-title'), False, False, 0)
        box.pack_start(label('Add your own fonts (.ttf .otf .ttc .otc). They are saved in your account and every program can use them.', 'mas-sub', wrap=True), False, False, 0)
        bar = Gtk.Box(spacing=10)
        add = Gtk.Button(label='Add fonts...'); add.get_style_context().add_class('suggested-action'); add.connect('clicked', self.on_add_font)
        self.f_remove = Gtk.Button(label='Remove selected'); self.f_remove.connect('clicked', self.on_remove_font); self.f_remove.set_sensitive(False)
        bar.pack_start(add, False, False, 0); bar.pack_start(self.f_remove, False, False, 0)
        box.pack_start(bar, False, False, 0)
        self.f_list = Gtk.ListBox(); self.f_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.f_list.connect('row-selected', lambda _l, r: self.f_remove.set_sensitive(r is not None and hasattr(r, 'path')))
        sc = Gtk.ScrolledWindow(); sc.set_min_content_height(200); sc.set_vexpand(True); sc.add(self.f_list)
        box.pack_start(sc, True, True, 0)
        box.pack_start(label('Interface font', 'mas-title'), False, False, 6)
        row = Gtk.Box(spacing=10)
        self.f_btn = Gtk.FontButton(); self.f_btn.set_use_font(True); self.f_btn.set_show_size(True)
        rc, out = sh('xfconf-query', '-c', 'xsettings', '-p', '/Gtk/FontName')
        if rc == 0 and out.strip(): self.f_btn.set_font(out.strip())
        row.pack_start(self.f_btn, False, False, 0)
        ap = Gtk.Button(label='Use as system font'); ap.connect('clicked', self.on_font_apply)
        row.pack_start(ap, False, False, 0)
        box.pack_start(row, False, False, 0)
        self.f_msg = label('', 'mas-sub', wrap=True); box.pack_start(self.f_msg, False, False, 0)
        self.reload_fonts()
        return box

    def reload_fonts(self):
        for r in self.f_list.get_children(): self.f_list.remove(r)
        rc, out = sh(FONTS, 'list')
        try: items = json.loads(out)
        except Exception: items = []
        for it in items:
            row = Gtk.ListBoxRow(); row.path = it['path']
            h = Gtk.Box(spacing=12, margin=8)
            h.pack_start(Gtk.Label(label=', '.join(it['families']) or it['file'], xalign=0), True, True, 0)
            f = Gtk.Label(label=it['file'], xalign=1); f.get_style_context().add_class('mas-sub'); h.pack_start(f, False, False, 0)
            row.add(h); self.f_list.add(row)
        if not items:
            row = Gtk.ListBoxRow(); row.set_activatable(False); row.set_selectable(False)
            l = Gtk.Label(label='No fonts added yet.', margin=16); l.get_style_context().add_class('mas-sub'); row.add(l); self.f_list.add(row)
        self.f_list.show_all()

    def on_add_font(self, _b):
        dlg = Gtk.FileChooserDialog(title='Choose font files', parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Add', Gtk.ResponseType.OK); dlg.set_select_multiple(True)
        f = Gtk.FileFilter(); f.set_name('Fonts (.ttf .otf .ttc .otc)')
        for pat in ('*.ttf', '*.otf', '*.ttc', '*.otc', '*.TTF', '*.OTF', '*.TTC', '*.OTC'): f.add_pattern(pat)
        dlg.add_filter(f)
        if dlg.run() == Gtk.ResponseType.OK:
            files = dlg.get_filenames(); dlg.destroy()
            def work():
                rc, out = sh(FONTS, 'install', *files, timeout=300)
                GLib.idle_add(self.fonts_done, rc, out)
            threading.Thread(target=work, daemon=True).start()
        else:
            dlg.destroy()

    def fonts_done(self, rc, out):
        self.f_msg.set_text('Font added. Pick it above and press "Use as system font" if you want it everywhere.' if rc == 0 else 'That file could not be added (is it a real font?).')
        self.reload_fonts(); return False

    def on_remove_font(self, _b):
        row = self.f_list.get_selected_row()
        if row is not None and hasattr(row, 'path'):
            sh(FONTS, 'remove', row.path); self.reload_fonts(); self.f_msg.set_text('Font removed.')

    def on_font_apply(self, _b):
        name = self.f_btn.get_font()
        sh('xfconf-query', '-c', 'xsettings', '-p', '/Gtk/FontName', '-n', '-t', 'string', '-s', name)
        self.f_msg.set_text('System font is now ' + name + '.')

    # ------------------------------------------------------------ Update
    def page_update(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=28)
        self.u_title = label('MAS', 'mas-title'); box.pack_start(self.u_title, False, False, 0)
        self.u_state = label('', wrap=True); box.pack_start(self.u_state, False, False, 0)
        self.u_notes = label('', 'mas-sub', wrap=True); box.pack_start(self.u_notes, False, False, 0)
        self.u_checked = label('', 'mas-sub'); box.pack_start(self.u_checked, False, False, 0)
        bar = Gtk.Box(spacing=10); self.u_check = Gtk.Button(label='Check for updates'); self.u_check.connect('clicked', lambda _b: self.u_run('check'))
        self.u_install = Gtk.Button(label='Install now'); self.u_install.get_style_context().add_class('suggested-action')
        self.u_install.connect('clicked', lambda _b: self.u_run('install'))
        self.u_restart = Gtk.Button(label='Restart now'); self.u_restart.get_style_context().add_class('suggested-action')
        self.u_restart.connect('clicked', lambda _b: sh('systemctl', 'reboot'))
        self.u_spin = Gtk.Spinner()
        for w in (self.u_check, self.u_install, self.u_restart, self.u_spin): bar.pack_start(w, False, False, 0)
        box.pack_start(bar, False, False, 10)
        box.pack_start(label('MAS looks for updates by itself every 24 hours and installs them in the background, like Windows 10.', 'mas-sub', wrap=True), False, False, 0)
        return box

    def refresh_update(self):
        def work():
            rc, out = sh(UPDATE, 'status', timeout=20)
            try: st = json.loads(out)
            except Exception: st = {}
            GLib.idle_add(self.show_update, st)
        threading.Thread(target=work, daemon=True).start()

    def show_update(self, st):
        cur = st.get('current', '?'); state = st.get('state', '')
        self.u_title.set_text(f'MAS {cur}')
        texts = {'uptodate': 'You are up to date.', 'available': f'Version {st.get("latest", "")} is ready to install.',
                 'installing': 'Installing the update...', 'installed': f'Updated to {st.get("latest", "")}.',
                 'error': 'The last update check did not finish: ' + str(st.get('error', '')), '': 'No check yet. Press "Check for updates".'}
        t = texts.get(state, state)
        if st.get('reboot_needed'): t = f'Updated to {st.get("latest", "")}. Restart to finish.'
        self.u_state.set_text(t)
        self.u_notes.set_text(st.get('notes', '') if state in ('available', 'installed') else '')
        ck = st.get('checked')
        self.u_checked.set_text('Last checked: ' + time.strftime('%d/%m/%Y %H:%M', time.localtime(ck)) if ck else '')
        self.u_install.set_visible(state == 'available'); self.u_restart.set_visible(bool(st.get('reboot_needed')))
        self.u_check.set_sensitive(not self.busy); self.u_install.set_sensitive(not self.busy)
        return False

    def u_run(self, what):
        self.busy = True; self.u_spin.start(); self.u_check.set_sensitive(False); self.u_install.set_sensitive(False)
        self.u_state.set_text('Checking...' if what == 'check' else 'Installing the update...')
        def work():
            sh('sudo', '-n', UPDATE, what, timeout=900)
            GLib.idle_add(self.u_done)
        threading.Thread(target=work, daemon=True).start()

    def u_done(self):
        self.busy = False; self.u_spin.stop(); self.refresh_update()
        return False

    # ------------------------------------------------------------ About
    def page_about(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=28)
        top = Gtk.Box(spacing=18)
        img = Gtk.Image.new_from_icon_name('mas-start', Gtk.IconSize.DIALOG); img.set_pixel_size(84)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER)
        info = sysinfo()
        v.pack_start(label(info['_host'], 'mas-title'), False, False, 0)
        v.pack_start(label(info['_model'], 'mas-sub'), False, False, 0)
        top.pack_start(img, False, False, 0); top.pack_start(v, True, True, 0)
        cp = Gtk.Button(label='Copy to clipboard'); cp.set_valign(Gtk.Align.CENTER)
        def copy(_b):
            txt = '\n'.join('%s: %s' % (k, val) for sect in info['_sections'] for k, val in sect[1])
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(txt, -1); self.toast(cp, 'Copied')
        cp.connect('clicked', copy); top.pack_end(cp, False, False, 0)
        box.pack_start(top, False, False, 0)
        for title, rows in info['_sections']:
            box.pack_start(label(title, 'mas-section'), False, False, 6)
            card = Gtk.Grid(column_spacing=24, row_spacing=7); card.get_style_context().add_class('mas-card')
            for i, (k, val) in enumerate(rows):
                kl = label(k, 'mas-sub'); kl.set_valign(Gtk.Align.START); kl.set_size_request(190, -1)
                vl = label(val, wrap=True); vl.set_selectable(True); vl.set_hexpand(True); vl.set_max_width_chars(70)
                card.attach(kl, 0, i, 1, 1); card.attach(vl, 1, i, 1, 1)
            box.pack_start(card, False, False, 0)
        return box


def main():
    page = sys.argv[1] if len(sys.argv) > 1 else 'home'
    w = Settings(page); w.connect('destroy', Gtk.main_quit); Gtk.main()


if __name__ == '__main__':
    main()
