#!/usr/bin/python3
"""mas-settings - MAS Settings (home with categories, like Windows 10).   mas-settings [home|personalize|fonts|update|about|<category>]"""
import json, os, subprocess, sys, threading, time

import gi
gi.require_version('Gtk', '3.0'); gi.require_version('Gdk', '3.0'); gi.require_version('GdkPixbuf', '2.0')
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf

SHARE = os.environ.get('MAS_SHARE', '/usr/share/mas')
APPEAR = os.environ.get('MAS_APPEARANCE', '/usr/local/bin/mas-appearance')
UPDATE = os.environ.get('MAS_UPDATE', '/usr/local/bin/mas-update')
FONTS = os.environ.get('MAS_FONTS', '/usr/local/bin/mas-fonts')
BACKS = [('mas', 'MAS'), ('mountains', 'Mountains'), ('midnight', 'Midnight'), ('aurora', 'Aurora')]


def sh(*a, timeout=120):
    try:
        r = subprocess.run(a, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except Exception as e:
        return 1, str(e)


def appearance():
    rc, out = sh(APPEAR, 'show')
    try: return json.loads(out)
    except Exception: return {'mode': 'dark', 'wallpaper': 'mas', 'effects': True}


def label(text, cls=None, xalign=0.0, wrap=False):
    l = Gtk.Label(label=text, xalign=xalign); l.set_line_wrap(wrap)
    if cls: l.get_style_context().add_class(cls)
    return l


DEFAULT_ON = {'/Net/EnableEventSounds', '/Net/CursorBlink', '/Gtk/EnableAnimations', '/general/use_compositing', '/general/snap_to_border', '/xfce4-power-manager/dpms-enabled', '/general/tile_on_move', '/general/zoom_desktop'}

# ---------------------------------------------------------------- the settings catalogue
# kinds: page (opens a MAS page) | run (starts a program) | toggle (xfconf bool/int) | choice (xfconf int) | cmdtoggle | cmdchoice | action
def T(ch, prop, title, desc, on=True, off=False, typ='bool'):
    return dict(kind='toggle', ch=ch, prop=prop, title=title, desc=desc, on=on, off=off, typ=typ)

def C(ch, prop, title, desc, opts, default=None):
    return dict(kind='choice', ch=ch, prop=prop, title=title, desc=desc, opts=opts, default=default if default is not None else opts[0][1])

def R(title, desc, cmd):
    return dict(kind='run', title=title, desc=desc, cmd=cmd)

def P(title, desc, page):
    return dict(kind='page', title=title, desc=desc, page=page)

