#!/usr/bin/env bash
# mas-firstlogin - runs once per user at first login: dark theme, MAS wallpaper,
# the MAS logo on the start button, and the Flathub app source.
MARK="$HOME/.config/mas/firstlogin-done"
[[ -e "$MARK" ]] && exit 0
mkdir -p "$(dirname "$MARK")"

# Wait for the desktop to be ready (up to about a minute)
for _ in $(seq 1 30); do
  busctl --user status org.kde.plasmashell >/dev/null 2>&1 && break
  sleep 2
done
sleep 3

plasma-apply-colorscheme BreezeDark >/dev/null 2>&1 || true
plasma-apply-wallpaperimage /usr/share/wallpapers/MAS >/dev/null 2>&1 \
  || plasma-apply-wallpaperimage /usr/share/wallpapers/MAS/contents/images_dark/2560x1440.jpg >/dev/null 2>&1 || true

# Put the MAS logo on the start button
JS='
var all = panels();
for (var i = 0; i < all.length; i++) {
  var ws = all[i].widgets();
  for (var j = 0; j < ws.length; j++) {
    if (ws[j].type === "org.kde.plasma.kickoff" || ws[j].type === "org.kde.plasma.kicker") {
      ws[j].currentConfigGroup = ["General"];
      ws[j].writeConfig("icon", "/usr/share/mas/mas-icon.png");
      ws[j].reloadConfig();
    }
  }
}'
busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$JS" >/dev/null 2>&1 || true

flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 &

touch "$MARK"
