#!/usr/bin/env bash
# mas-apply [ROOT]
# Turns an Arch Linux install into MAS OS: installs the MAS packages, adds the branding,
# launchers, firewall and shield, and turns on the services.
#   mas-apply                      apply to the system you are running
#   mas-apply /mnt/archinstall     apply to a freshly installed system (used by mas-install)
set -uo pipefail

if [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

LAYER=/usr/share/mas-layer
ROOT="${1:-/}"
R="${ROOT%/}"          # "" when ROOT is /
if [[ ! -d "$LAYER/overlay" ]]; then
  echo "MAS layer files not found in $LAYER" >&2
  exit 1
fi
if [[ -n "$R" && ! -d "$R/etc" ]]; then
  echo "$ROOT does not look like an installed system." >&2
  exit 1
fi

in_root() {
  if [[ -z "$R" ]]; then "$@"; else arch-chroot "$R" "$@"; fi
}

echo "==> Keeping a copy of the MAS layer in the installed system"
mkdir -p "$R/usr/share"
if [[ -n "$R" ]]; then
  rm -rf "$R/usr/share/mas-layer"
  cp -a "$LAYER" "$R/usr/share/mas-layer"
fi

echo "==> Turning on the 32-bit (multilib) repository"
PACCONF="$R/etc/pacman.conf"
sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' "$PACCONF"
if ! grep -q '^\[multilib\]' "$PACCONF"; then
  printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> "$PACCONF"
fi
in_root pacman -Syu --noconfirm   # a full upgrade, never a partial one

echo "==> Installing MAS packages"
mapfile -t REQ < <(grep -vE '^\s*(#|$)' "$LAYER/packages.txt")
if ! in_root pacman -S --needed --noconfirm "${REQ[@]}"; then
  echo "Package install failed. Check your internet connection and run: sudo mas-apply" >&2
  exit 1
fi
while read -r pkg; do
  in_root pacman -S --needed --noconfirm "$pkg" >/dev/null 2>&1 \
    && echo "    + $pkg" || echo "    (skipped optional package: $pkg)"
done < <(grep -vE '^\s*(#|$)' "$LAYER/optional.txt")

echo "==> Adding MAS branding, launchers and the shield"
# /etc/os-release is normally a link to /usr/lib/os-release (owned by the system package and reset by
# updates). Replace the link with a real file so the MAS name is kept.
if [[ -L "$R/etc/os-release" ]]; then rm -f "$R/etc/os-release"; fi
cp -a "$LAYER/overlay/." "${R:-/}"
chmod 755 "$R"/usr/local/bin/mas-* 2>/dev/null || true
chmod 440 "$R"/etc/sudoers.d/mas-welcome "$R"/etc/sudoers.d/10-mas-wheel 2>/dev/null || true
# A freshly installed system asks "Add a password or not?" at the first login (mas-welcome)
if [[ -n "$R" ]]; then
  mkdir -p "$R/var/lib/mas"
  : > "$R/var/lib/mas/firstrun-pending"
fi

if [[ -n "$R" ]]; then
  # Fresh install only: the default account "mas" with NO password. It can create other accounts,
  # and once you have another administrator account you can delete it (Start menu > Accounts).
  # While it has no password it signs in by itself and can do administrator tasks.
  # Setting a password for it (first-run screen) switches all of that off.
  echo "==> Creating the default account 'mas' (no password)"
  if ! in_root id -u mas >/dev/null 2>&1; then
    in_root useradd -m -G wheel -s /bin/bash -c "MAS" mas
    in_root passwd -d mas >/dev/null 2>&1 || true
    # no automatic screen lock while the account has no password (the welcome screen removes this)
    mkdir -p "$R/home/mas/.config"
    printf '[Daemon]\nAutolock=false\nLockOnResume=false\n' > "$R/home/mas/.config/kscreenlockerrc"
    in_root chown -R mas:mas /home/mas/.config
    mkdir -p "$R/var/lib/mas" "$R/etc/sddm.conf.d"
    : > "$R/var/lib/mas/default-open"
    echo mas > "$R/var/lib/mas/passwordless"
    chmod 644 "$R/var/lib/mas/passwordless"
    printf 'mas ALL=(ALL:ALL) NOPASSWD: ALL\n' > "$R/etc/sudoers.d/mas-default-open"
    chmod 440 "$R/etc/sudoers.d/mas-default-open"
    sess=""
    for s in plasma plasmawayland plasma-wayland; do
      if [[ -f "$R/usr/share/wayland-sessions/$s.desktop" ]]; then sess="$s"; break; fi
    done
    {
      echo "[Autologin]"
      echo "User=mas"
      if [[ -n "$sess" ]]; then echo "Session=$sess"; fi
    } > "$R/etc/sddm.conf.d/mas-default-autologin.conf"
  fi
fi

echo "==> Turning on services"
in_root systemctl disable systemd-networkd.service iwd.service >/dev/null 2>&1 || true
in_root systemctl enable sddm.service NetworkManager.service nftables.service mas-gfx.service mas-boot-prompt.service mas-theme-check.service mas-theme-guard.service
in_root systemctl enable snapper-timeline.timer snapper-cleanup.timer grub-btrfs.path >/dev/null 2>&1 || true

# Restore points: Snapper needs a config for "/". archinstall only makes one on some choices, so make it here.
if [[ "$(stat -f -c %T "${R:-/}" 2>/dev/null)" == btrfs ]]; then
  if [[ ! -f "$R/etc/snapper/configs/root" ]] && [[ -f "$R/etc/snapper/config-templates/default" ]]; then
    echo "==> Setting up restore points (Snapper)"
    mkdir -p "$R/etc/snapper/configs"
    sed 's|^SUBVOLUME=.*|SUBVOLUME="/"|' "$R/etc/snapper/config-templates/default" > "$R/etc/snapper/configs/root"
    mkdir -p "$R/etc/conf.d"
    if [[ -f "$R/etc/conf.d/snapper" ]] && grep -q '^SNAPPER_CONFIGS=' "$R/etc/conf.d/snapper"; then
      sed -i 's|^SNAPPER_CONFIGS=.*|SNAPPER_CONFIGS="root"|' "$R/etc/conf.d/snapper"
    else
      echo 'SNAPPER_CONFIGS="root"' >> "$R/etc/conf.d/snapper"
    fi
    if [[ ! -d "$R/.snapshots" ]]; then
      in_root btrfs subvolume create /.snapshots >/dev/null 2>&1 || echo "    (could not create /.snapshots)"
    fi
    chmod 750 "$R/.snapshots" 2>/dev/null || true
  fi
else
  echo "==> NOTE: this system does not use Btrfs, so restore points (snapshots) are OFF."
fi

# Boot logo (Plymouth) instead of the [ OK ] lines. Everything here is optional: if it fails, boot still works.
if [[ -x "$R/usr/bin/plymouth-set-default-theme" || -x "$R/usr/bin/plymouthd" ]]; then
  echo "==> Boot logo"
  MK="$R/etc/mkinitcpio.conf"
  if [[ -f "$MK" ]] && ! grep -q plymouth "$MK"; then
    if grep -q '^HOOKS=.*\bsystemd\b' "$MK"; then
      sed -i '/^HOOKS=/ s/\bsystemd\b/systemd plymouth/' "$MK"
    else
      sed -i '/^HOOKS=/ s/\budev\b/udev plymouth/' "$MK"
    fi
  fi
  in_root mkinitcpio -P >/dev/null 2>&1 || echo "    (could not rebuild the boot image, the boot logo may not show)"
  GR="$R/etc/default/grub"
  if [[ -f "$GR" ]] && ! grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=.*splash' "$GR"; then
    sed -i '/^GRUB_CMDLINE_LINUX_DEFAULT=/ s/"$/ quiet splash"/' "$GR"
    in_root grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || true
  fi
  for e in "$R"/boot/loader/entries/*.conf; do
    if [[ -f "$e" ]] && ! grep -q splash "$e"; then sed -i '/^options / s/$/ quiet splash/' "$e"; fi
  done
fi

echo
echo "MAS OS is set up. Reboot to start it."
