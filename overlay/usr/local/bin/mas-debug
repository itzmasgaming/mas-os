#!/usr/bin/env bash
# mas-debug - shows why the desktop did not start (black screen, no panel ...).
#   mas-debug          full report, saved to ~/mas-debug.txt, short version printed
#   mas-debug --brief  one-screen report
#   mas-debug --auto   waits about a minute, saves the report, switches to the second text
#                      console (Right Ctrl + F2 in VirtualBox if you want it again) and prints it there
# On a text console: Right Ctrl + F3 in VirtualBox, log in as "mas" with no password, run: mas-debug
HOME="${HOME:-/root}"
OUT="$HOME/mas-debug.txt"

brief() {
  echo "MAS debug $(date +%H:%M)  kernel $(uname -r)"
  echo "virtual machine: $(systemd-detect-virt --vm 2>/dev/null || echo no)   $(/usr/local/bin/mas-gfx status 2>/dev/null | head -n1)"
  echo "sddm: $(systemctl is-active sddm 2>/dev/null)   $(grep -h '^Session=' /etc/sddm.conf.d/*.conf 2>/dev/null | head -n1)   sessions: $(ls /usr/share/wayland-sessions 2>/dev/null | tr '\n' ' ')"
  echo "running: $(ps -eo comm= 2>/dev/null | grep -E '^(kwin_wayland|plasmashell|sddm-greeter|Xorg|startplasma-way|sddm-helper)' | sort -u | tr '\n' ' ')"
  echo "dri: $(ls /dev/dri 2>/dev/null | tr '\n' ' ')"
  echo "--- sddm ---"
  journalctl -b -u sddm --no-pager -o cat 2>/dev/null | tail -n 4 | cut -c1-78
  # The desktop writes its own start-up messages here (the newest log of any account)
  sl="$(ls -t /home/*/.local/share/sddm/wayland-session.log /home/*/.local/share/sddm/xorg-session.log 2>/dev/null | head -n1)"
  if [[ -n "$sl" ]]; then
    echo "--- $(basename "$sl") ($(echo "$sl" | cut -d/ -f3)) ---"
    tail -n 7 "$sl" | cut -c1-78
  fi
  echo "--- errors ---"
  journalctl -b --no-pager -o cat 2>/dev/null | grep -iE 'kwin|plasma|startplasma|xfce|vmwgfx|drm|egl|gbm|qml' | grep -iE 'fail|error|crash|abort|cannot|unable|segfault|dump|not found' | tail -n 5 | cut -c1-78
}

full() {
  echo "== MAS debug =="
  echo "date: $(date)"
  echo "kernel: $(uname -r)"
  echo "boot options: $(cat /proc/cmdline)"
  brief
  echo
  echo "== sddm autologin =="
  cat /etc/sddm.conf.d/autologin.conf 2>/dev/null
  echo
  echo "== graphics devices =="
  lspci 2>/dev/null | grep -iE 'vga|3d|display' || true
  echo
  echo "== desktop start-up logs (last 40 lines each) =="
  for f in /home/*/.local/share/sddm/wayland-session.log /home/*/.local/share/sddm/xorg-session.log; do
    if [[ -f "$f" ]]; then echo "-- $f"; tail -n 40 "$f"; fi
  done
  echo
  echo "== sddm log (last 40) =="
  journalctl -b -u sddm --no-pager 2>/dev/null | tail -n 40
  echo '--- desktop start failures (login screen notes) ---'
  head -n 8 /var/lib/mas/flags/plasma-failed-* 2>/dev/null | cut -c1-110
  echo '--- login theme ---'
  journalctl -b -t mas-theme --no-pager -o cat 2>/dev/null | tail -n 10
  echo
  echo "== desktop log, errors only (last 60) =="
  journalctl -b --no-pager 2>/dev/null | grep -iE 'kwin|plasmashell|startplasma|drm|vmwgfx|egl|gbm' | grep -iE 'fail|error|crash|abort|cannot|unable|segfault|core dump' | tail -n 60
  echo
  echo "== units that failed =="
  systemctl --failed --no-pager 2>/dev/null
}

case "${1:-}" in
  --brief) brief ;;
  --auto)
    sleep 50
    full > "$OUT" 2>&1
    # A stuck desktop would keep the screen black, so stop it first, then go to the text console
    timeout 20 systemctl stop sddm 2>/dev/null || true
    pkill -9 -x kwin_wayland 2>/dev/null || true
    sleep 2
    chvt 2 2>/dev/null || true
    sleep 4
    { echo; brief; echo; echo "(full report: $OUT)"; } > /dev/tty2 2>/dev/null || brief
    ;;
  *)
    full > "$OUT" 2>&1
    echo "Saved to $OUT. Short version:"
    echo
    brief
    ;;
esac
