#!/usr/bin/env bash
# mas-xfce-setup - runs at the first logins in the XFCE desktop: MAS wallpaper.
# It tries for about a minute (xfdesktop may not have written its settings yet) and only remembers
# that it is done when the wallpaper was really applied.
MARK="$HOME/.config/mas/xfce-setup-done"
[[ -e "$MARK" ]] && exit 0
mkdir -p "$(dirname "$MARK")"
IMG=/usr/share/mas/wallpaper-dark.jpg
Q=(xfconf-query -c xfce4-desktop)

apply_existing() { # sets every wallpaper property xfdesktop already has; prints how many
  local prop n=0
  while read -r prop; do
    case "$prop" in
      */last-image) "${Q[@]}" -p "$prop" -s "$IMG" && n=$((n + 1)) ;;
      */image-style) "${Q[@]}" -p "$prop" -s 5 ;;
    esac
  done < <("${Q[@]}" -l 2>/dev/null | grep -E '/(last-image|image-style)$')
  echo "$n"
}

create_new() { # no properties yet: create them for every connected monitor
  local m n=0
  command -v xrandr >/dev/null 2>&1 || { echo 0; return; }
  while read -r m; do
    "${Q[@]}" -p "/backdrop/screen0/monitor$m/workspace0/last-image" -n -t string -s "$IMG" \
      && "${Q[@]}" -p "/backdrop/screen0/monitor$m/workspace0/image-style" -n -t int -s 5 && n=$((n + 1))
  done < <(xrandr --query 2>/dev/null | awk '/ connected/{print $1}')
  echo "$n"
}

sleep 4
for _ in $(seq 1 15); do
  done_n="$(apply_existing)"
  if [[ "${done_n:-0}" -eq 0 ]]; then done_n="$(create_new)"; fi
  if [[ "${done_n:-0}" -gt 0 ]]; then touch "$MARK"; exit 0; fi
  sleep 4
done
exit 0   # no mark: it tries again at the next login
