#!/usr/bin/env bash
# mas-passwordless add|remove NAME - keeps /var/lib/mas/passwordless up to date.
# That list (one account name per line, readable by everyone) tells the login screen which accounts
# have no password, so it can show a "Sign In" button instead of a password box.
FILE="${MAS_PASSWORDLESS:-/var/lib/mas/passwordless}"
action="${1:-}"
name="${2:-}"

if [[ ! "$name" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
  echo "usage: mas-passwordless add|remove NAME" >&2
  exit 1
fi
mkdir -p "$(dirname "$FILE")"
touch "$FILE"

case "$action" in
  add)
    if ! grep -qx "$name" "$FILE"; then printf '%s\n' "$name" >> "$FILE"; fi
    ;;
  remove)
    sed -i "/^${name}\$/d" "$FILE"
    ;;
  *)
    echo "usage: mas-passwordless add|remove NAME" >&2
    exit 1
    ;;
esac
chmod 644 "$FILE" 2>/dev/null || true
