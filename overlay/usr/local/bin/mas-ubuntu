#!/usr/bin/env bash
# mas-ubuntu - opens a small window with an Ubuntu LTS command line (like WSL).
NAME=ubuntu
IMAGE=docker.io/library/ubuntu:latest

# Re-open inside a normal-sized terminal window
if [[ -z "${MAS_IN_TERM:-}" ]]; then
  exec env MAS_IN_TERM=1 xfce4-terminal --geometry=100x28 --title "Ubuntu LTS" -x "$0" "$@"
fi

if ! distrobox list 2>/dev/null | grep -qw "$NAME"; then
  echo "Setting up Ubuntu LTS (first time only, needs internet)..."
  if ! distrobox create --yes --name "$NAME" --image "$IMAGE"; then
    echo "Setup failed."
    read -r -p "Press Enter to close..." _
    exit 1
  fi
fi

# "apt update" etc. work without typing sudo (the Ubuntu inside is yours; sudo has no password there)
RC="$HOME/.config/mas/ubuntu-bashrc"
mkdir -p "$(dirname "$RC")"
cat > "$RC" <<'RCEOF'
[ -f ~/.bashrc ] && . ~/.bashrc
for _c in apt apt-get dpkg add-apt-repository; do
  eval "$_c() { if [ \"\$(id -u)\" -ne 0 ]; then sudo $_c \"\$@\"; else command $_c \"\$@\"; fi; }"
done
unset _c
RCEOF
exec distrobox enter "$NAME" -- bash --rcfile "$RC" -i
