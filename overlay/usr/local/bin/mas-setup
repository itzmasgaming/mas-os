#!/usr/bin/env python3
"""mas-setup - the first-time setup of MAS OS. Starts by itself when you boot the ISO.

Three steps:  1 account name + disk   2 password (or skip)   3 installing, then restart.
Nothing else to click: the installer (mas-install-auto) runs by itself behind step 3.

Exit codes: 0 = installed (the computer is restarting), 10 = "try MAS without installing".
Options:    --windowed WxH  open in a normal window (testing)      --fake  pretend to install (testing)
"""
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading

os.environ.setdefault("GSK_RENDERER", "cairo")   # CPU drawing: works on every virtual graphics card

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402

try:
    import cairo  # noqa: F401  (needed by Gtk.DrawingArea draw functions)
    HAVE_CAIRO = True
except ImportError:
    HAVE_CAIRO = False

INSTALLER = os.environ.get("MAS_INSTALLER", "/usr/local/bin/mas-install-auto")
LOGO = os.environ.get("MAS_LOGO", "/usr/share/mas/mas-logo-white.png")
LIVE_MARK = "/run/archiso"
MIN_DISK_GB = 20
NAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,30}$")
RESERVED = {"root", "mas", "nobody", "admin", "administrator", "daemon", "bin", "sys", "sudo", "wheel", "guest"}

ARGS = sys.argv[1:]
FAKE = "--fake" in ARGS or os.environ.get("MAS_SETUP_FAKE") == "1"
WINDOWED = None
if "--windowed" in ARGS:
    try:
        w, h = ARGS[ARGS.index("--windowed") + 1].lower().split("x")
        WINDOWED = (int(w), int(h))
    except (IndexError, ValueError):
        WINDOWED = (1280, 720)

# ---------------------------------------------------------------------------------------------- style
BG = "#0b0f19"
LINE = "#1a2133"
TEXT = "#e8ecf8"
MUTED = "#8a93a8"
BLUE = "#7b9bff"


