#!/usr/bin/env bash
# mas-gfx-ask - the live system asks, before the login screen starts, how the desktop should start.
# Runs from mas-gfx-ask.service on the first text console. No key pressed = Automatic.
# Skipped when the boot option  mas.gfx=...  is already given.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN="${MAS_RUN:-/run}"
CMDLINE="${MAS_CMDLINE:-/proc/cmdline}"

if grep -q 'mas\.gfx=' "$CMDLINE" 2>/dev/null; then exit 0; fi

if command -v plymouth >/dev/null 2>&1; then plymouth quit 2>/dev/null || true; fi
clear 2>/dev/null || true
cat <<'EOF'

   MAS OS
   ------
   How should the desktop start?

     1   Automatic       (recommended)
     2   Safe            Plasma drawn by the CPU. Try this if the screen goes black.
     3   OpenGL on CPU   Plasma, a bit faster than Safe
     4   Graphics card   Plasma for real computers
     5   Simple desktop  XFCE. Works in every virtual machine. Use it if 1 and 2 stay black.
     6   Troubleshoot    starts normally, then shows a report about what went wrong

   Press 1-6. Nothing pressed in 12 seconds = 1.

EOF

key=""
read -rsn1 -t 12 key || key=""

mode=auto
case "$key" in
  2) mode=basic ;;
  3) mode=soft ;;
  4) mode=normal ;;
  5) mode=xfce ;;
  6) mode=auto; touch "$RUN/mas-debug-auto" ;;
esac

"$HERE/mas-gfx" "$mode" >/dev/null 2>&1 || true
echo "   Starting with: $mode"
if [[ "$key" == 6 && -z "${MAS_ROOT:-}" ]]; then
  echo "   A report appears on screen about a minute after the desktop starts."
  systemctl start --no-block mas-debug-auto.service >/dev/null 2>&1 || true
fi
sleep 1
exit 0
