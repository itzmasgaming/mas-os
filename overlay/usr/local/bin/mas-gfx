#!/usr/bin/env bash
# mas-gfx - picks how the desktop draws itself, so MAS does not end on a black screen
# in a virtual machine (VirtualBox, VMware, QEMU ...) whose virtual graphics card is weak.
#
#   mas-gfx apply          run at boot (by mas-gfx.service) before the login screen starts
#   mas-gfx normal         use the graphics card as normal (real computers)
#   mas-gfx soft           draw with the CPU through OpenGL software rendering (llvmpipe)
#   mas-gfx basic          draw with the CPU, no OpenGL at all (slowest, most reliable Plasma mode)
#   mas-gfx xfce           the simple XFCE desktop instead of Plasma (works in every virtual machine)
#   mas-gfx auto           inside a virtual machine: the XFCE desktop (basic Plasma if XFCE is missing); on a real computer: Plasma with the graphics card (default)
#   mas-gfx status         show the current choice
#
# Order of choice: the boot option  mas.gfx=normal|soft|basic|xfce|auto  wins, then /etc/mas/gfx-mode, then auto.
# After changing it, run:  sudo systemctl restart sddm   (or reboot)
set -u

ROOT="${MAS_ROOT:-}"
CONF="$ROOT/etc/mas/gfx-mode"
ENVD="$ROOT/etc/environment.d/90-mas-gfx.conf"
PROF="$ROOT/etc/profile.d/mas-gfx.sh"
GREETER="$ROOT/etc/sddm.conf.d/zz-mas-gfx.conf"
CMDLINE="${MAS_CMDLINE:-/proc/cmdline}"

valid() { case "$1" in normal|soft|basic|auto|xfce) return 0 ;; *) return 1 ;; esac; }

cmdline_mode() {
  local w
  for w in $(cat "$CMDLINE" 2>/dev/null); do
    case "$w" in mas.gfx=*) echo "${w#mas.gfx=}"; return ;; esac
  done
}

wanted_mode() {
  local m
  m="$(cmdline_mode)"
  if [[ -n "$m" ]] && valid "$m"; then echo "$m"; return; fi
  m="$(cat "$CONF" 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ -n "$m" ]] && valid "$m"; then echo "$m"; return; fi
  echo auto
}

resolve() { # auto -> xfce (or basic) inside a virtual machine, normal on a real computer
  if [[ "$1" != auto ]]; then echo "$1"; return; fi
  if systemd-detect-virt --vm --quiet 2>/dev/null; then
    # Plasma (Wayland only) is not reliable on virtual graphics cards, so a VM gets the simple XFCE
    # desktop automatically when it is installed; otherwise Plasma drawn by the CPU.
    if [[ -f "$ROOT/usr/share/xsessions/xfce.desktop" ]]; then echo xfce; else echo basic; fi
  else
    echo normal
  fi
}

vars_for() { # prints NAME=value lines for a mode
  case "$1" in
    soft)
      echo "LIBGL_ALWAYS_SOFTWARE=1"
      echo "KWIN_DRM_NO_AMS=1"
      ;;
    basic)
      echo "LIBGL_ALWAYS_SOFTWARE=1"
      echo "KWIN_COMPOSE=Q"
      echo "KWIN_DRM_NO_AMS=1"
      echo "KWIN_FORCE_SW_CURSOR=1"
      echo "QT_QUICK_BACKEND=software"
      echo "GSK_RENDERER=cairo"
      ;;
  esac
}

write_env() {
  local mode="$1" v
  mkdir -p "$(dirname "$ENVD")" "$(dirname "$PROF")"
  rm -f "$ENVD" "$PROF" "$GREETER"
  # The login screen itself (the SDDM greeter) also draws with the CPU in basic/soft mode, and in a
  # virtual machine when XFCE is chosen. This line replaces the greeter line of mas-theme.conf, so it
  # repeats QML_XHR_ALLOW_FILE_READ.
  local soft_greeter=0
  if [[ "$mode" == basic || "$mode" == soft ]]; then soft_greeter=1; fi
  if [[ "$mode" == xfce ]] && systemd-detect-virt --vm --quiet 2>/dev/null; then soft_greeter=1; fi
  if [[ $soft_greeter -eq 1 ]]; then
    mkdir -p "$(dirname "$GREETER")"
    printf '[General]\nGreeterEnvironment=QML_XHR_ALLOW_FILE_READ=1,QT_QUICK_BACKEND=software,LIBGL_ALWAYS_SOFTWARE=1\n' > "$GREETER"
  fi
  if [[ "$mode" == normal || "$mode" == xfce ]]; then return; fi
  {
    echo "# written by mas-gfx (mode: $mode) - do not edit, use: mas-gfx normal|soft|basic|auto"
    vars_for "$mode"
  } > "$ENVD"
  {
    echo "# written by mas-gfx (mode: $mode)"
    while read -r v; do echo "export $v"; done < <(vars_for "$mode")
  } > "$PROF"
}

fix_autologin_session() { # $1 = mode. Live ISO only: make sure the autologin session file really exists
  local f files=() wl="$ROOT/usr/share/wayland-sessions" xs="$ROOT/usr/share/xsessions" pick="" s
  # the live ISO and the installed default account each have an autologin file
  for f in "$ROOT/etc/sddm.conf.d/autologin.conf" "$ROOT/etc/sddm.conf.d/mas-default-autologin.conf"; do
    if [[ -f "$f" ]]; then files+=("$f"); fi
  done
  [[ ${#files[@]} -gt 0 ]] || return 0
  if [[ "$1" == xfce && -f "$xs/xfce.desktop" ]]; then
    pick="xfce"
  elif [[ -d "$wl" ]]; then
    for s in plasma plasmawayland plasma-wayland; do
      if [[ -f "$wl/$s.desktop" ]]; then pick="$s"; break; fi
    done
    if [[ -z "$pick" ]]; then
      pick="$(find "$wl" -maxdepth 1 -name '*plasma*.desktop' -printf '%f\n' 2>/dev/null | sort | head -n1)"
      pick="${pick%.desktop}"
    fi
  fi
  if [[ -n "$pick" ]]; then
    for f in "${files[@]}"; do
      if grep -q '^Session=' "$f"; then
        sed -i "s/^Session=.*/Session=$pick/" "$f"
      else
        echo "Session=$pick" >> "$f"
      fi
    done
  fi
}

case "${1:-status}" in
  apply)
    want="$(wanted_mode)"
    mode="$(resolve "$want")"
    write_env "$mode"
    fix_autologin_session "$mode"
    echo "mas-gfx: mode=$mode (wanted: $want)"
    ;;
  normal|soft|basic|auto|xfce)
    if [[ $EUID -ne 0 && -z "${MAS_ROOT:-}" ]]; then echo "Run with sudo:  sudo mas-gfx $1" >&2; exit 1; fi
    mkdir -p "$(dirname "$CONF")"
    echo "$1" > "$CONF"
    write_env "$(resolve "$1")"
    fix_autologin_session "$(resolve "$1")"
    echo "Saved: $1. Now run:  sudo systemctl restart sddm   (or reboot)"
    ;;
  status)
    want="$(wanted_mode)"
    echo "wanted: $want   in use: $(resolve "$want")"
    if systemd-detect-virt --vm --quiet 2>/dev/null; then echo "virtual machine: $(systemd-detect-virt --vm)"; else echo "virtual machine: no"; fi
    ;;
  *)
    sed -n '2,16p' "$0"
    exit 1
    ;;
esac
